# Inpoints — environment variables

# Public site URL (used for canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://inpoints-landing.vercel.app

# Supabase (demo / contact requests) — same project as the InSports site:
# both write to public.demo_requests, told apart by its `product` column.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the API route to insert demo requests
SUPABASE_SERVICE_ROLE_KEY=
